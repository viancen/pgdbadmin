<% const page = Math.floor(offset / limit) + 1; const totalPages = Math.ceil(total / limit) || 1; %>
<% if (totalPages > 1 && baseUrl) { %>
<div class="flex items-center gap-2">
  <% if (page > 1) { %>
  <a href="<%= baseUrl %>?limit=<%= limit %>&offset=<%= Math.max(0, offset - limit) %>" class="btn-secondary text-xs">Previous</a>
  <% } %>
  <span class="text-sm text-slate-400">Page <%= page %> of <%= totalPages %></span>
  <% if (page < totalPages) { %>
  <a href="<%= baseUrl %>?limit=<%= limit %>&offset=<%= offset + limit %>" class="btn-secondary text-xs">Next</a>
  <% } %>
</div>
<% } %>
