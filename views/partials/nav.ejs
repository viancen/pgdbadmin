<nav class="fixed top-0 left-0 right-0 z-50 border-b border-pg-border bg-pg-panel/95 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4">
    <a href="/" class="font-display text-lg font-semibold text-white">
      <span class="text-pg-accent">PG</span> Admin
    </a>
    <div class="flex items-center gap-4">
      <% if (typeof currentDb !== 'undefined' && currentDb) { %>
      <div class="flex items-center gap-2">
        <span class="text-sm text-slate-400">Database</span>
        <form action="/switch-db" method="post" class="flex items-center gap-2">
          <select name="database" onchange="this.form.submit()" class="input max-w-[180px] py-1.5 text-sm">
            <% databases.forEach(function(db) { %>
            <option value="<%= db %>" <%= db === currentDb ? 'selected' : '' %>><%= db %></option>
            <% }); %>
          </select>
          <input type="hidden" name="_csrf" value="<%= typeof csrf !== 'undefined' ? csrf : '' %>" />
        </form>
      </div>
      <a href="/query" class="btn-ghost text-sm">SQL</a>
      <% } %>
      <span class="text-sm text-slate-500"><%= user %>@<%= host %></span>
      <form action="/logout" method="post" class="inline">
        <input type="hidden" name="_csrf" value="<%= typeof csrf !== 'undefined' ? csrf : '' %>" />
        <button type="submit" class="btn-ghost text-sm text-slate-400 hover:text-pg-danger">Log out</button>
      </form>
    </div>
  </div>
</nav>
