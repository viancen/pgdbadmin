<div class="mx-auto max-w-7xl px-4 py-8">
  <div class="mb-6 flex flex-wrap items-center gap-4">
    <a href="/" class="btn-ghost text-sm">← Database</a>
    <h1 class="font-display text-xl font-bold text-white">
      <span class="badge-schema"><%= schema %></span>.<span class="text-pg-accent"><%= tableName %></span>
    </h1>
    <a href="/table/<%= encodeURIComponent(schema) %>/<%= encodeURIComponent(tableName) %>/structure" class="btn-secondary text-sm">Structure</a>
    <a href="/query?table=<%= encodeURIComponent(schema) %>.<%= encodeURIComponent(tableName) %>" class="btn-primary text-sm">SQL</a>
  </div>
  <div class="card overflow-hidden">
    <div class="border-b border-pg-border px-6 py-3 flex items-center justify-between flex-wrap gap-2">
      <span class="text-sm text-slate-400"><%= total %> row<%= total !== 1 ? 's' : '' %></span>
      <%- include('partials/pagination', { total, limit, offset, baseUrl: '/table/' + encodeURIComponent(schema) + '/' + encodeURIComponent(tableName) }) %>
    </div>
    <div class="table-container max-h-[70vh] overflow-auto">
      <table class="data-table">
        <thead>
          <tr>
            <% fields.forEach(function(f) { %>
            <th class="whitespace-nowrap"><%= f.name %></th>
            <% }); %>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function(row) { %>
          <tr>
            <% fields.forEach(function(f) { %>
            <td class="max-w-xs truncate font-mono text-xs" title="<%= typeof row[f.name] === 'string' ? row[f.name].replace(/"/g, '&quot;') : row[f.name] %>"><%= row[f.name] === null ? '<span class="text-slate-500">NULL</span>' : row[f.name] %></td>
            <% }); %>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% if (!rows.length) { %>
    <div class="px-6 py-12 text-center text-slate-500">No rows.</div>
    <% } %>
  </div>
</div>
