<div class="mx-auto max-w-7xl px-4 py-8">
  <div class="mb-6">
    <h1 class="font-display text-2xl font-bold text-white">SQL Query</h1>
    <p class="text-sm text-slate-400">Run SELECT, INSERT, UPDATE, DELETE, or any valid PostgreSQL statement. Results are limited to 500 rows.</p>
  </div>
  <form action="/query" method="post" class="card overflow-hidden">
    <div class="border-b border-pg-border p-4">
      <textarea name="sql" id="sql" rows="8" class="input font-mono text-sm" placeholder="SELECT * FROM my_table LIMIT 10;"><%= typeof sql !== 'undefined' ? sql : '' %></textarea>
      <input type="hidden" name="_csrf" value="<%= typeof csrf !== 'undefined' ? csrf : '' %>" />
    </div>
    <div class="flex items-center justify-between border-b border-pg-border bg-slate-800/50 px-4 py-3">
      <span class="text-sm text-slate-500">Database: <strong class="text-slate-300"><%= currentDb %></strong></span>
      <button type="submit" class="btn-primary">Execute</button>
    </div>
  </form>
  <% if (typeof error !== 'undefined' && error) { %>
  <div class="mt-4 rounded-lg border border-pg-danger/50 bg-pg-danger/10 px-4 py-3 text-sm text-red-300">
    <%= error %>
  </div>
  <% } %>
  <% if (typeof result !== 'undefined' && result && result.fields && result.fields.length) { %>
  <div class="card mt-6 overflow-hidden">
    <div class="border-b border-pg-border px-6 py-3 flex items-center justify-between flex-wrap gap-2">
      <span class="text-sm text-slate-400"><%= result.rowCount %> row<%= result.rowCount !== 1 ? 's' : '' %> returned</span>
      <% if (result.total !== undefined && result.total > result.rows.length) { %>
      <span class="text-sm text-slate-500">(showing first <%= result.rows.length %>)</span>
      <% } %>
      <%- include('partials/pagination', { total: result.total || result.rows.length, limit: result.limit || 100, offset: result.offset || 0, baseUrl: null }) %>
    </div>
    <div class="table-container max-h-[60vh] overflow-auto">
      <table class="data-table">
        <thead>
          <tr>
            <% result.fields.forEach(function(f) { %>
            <th class="whitespace-nowrap"><%= f.name %></th>
            <% }); %>
          </tr>
        </thead>
        <tbody>
          <% result.rows.forEach(function(row) { %>
          <tr>
            <% result.fields.forEach(function(f) { %>
            <td class="max-w-xs truncate font-mono text-xs"><%= row[f.name] === null ? '<span class="text-slate-500">NULL</span>' : row[f.name] %></td>
            <% }); %>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% if (!result.rows.length) { %>
    <div class="px-6 py-8 text-center text-slate-500">No rows.</div>
    <% } %>
  </div>
  <% } %>
  <% if (typeof message !== 'undefined' && message && !result) { %>
  <div class="mt-4 rounded-lg border border-pg-success/50 bg-pg-success/10 px-4 py-3 text-sm text-green-300">
    <%= message %>
  </div>
  <% } %>
</div>
