<div class="flex min-h-screen items-center justify-center px-4">
  <div class="card w-full max-w-md p-8 shadow-glow">
    <div class="mb-8 text-center">
      <h1 class="font-display text-2xl font-bold text-white">
        <span class="text-pg-accent">PG</span> Admin
      </h1>
      <p class="mt-2 text-sm text-slate-400">Connect to PostgreSQL 18+</p>
    </div>
    <% if (typeof error !== 'undefined' && error) { %>
    <div class="mb-4 rounded-lg border border-pg-danger/50 bg-pg-danger/10 px-4 py-3 text-sm text-red-300">
      <%= error %>
    </div>
    <% } %>
    <form action="/login" method="post" class="space-y-4">
      <input type="hidden" name="_csrf" value="<%= typeof csrf !== 'undefined' ? csrf : '' %>" />
      <div>
        <label for="host" class="mb-1 block text-sm font-medium text-slate-400">Host</label>
        <input type="text" id="host" name="host" value="<%= typeof host !== 'undefined' ? host : 'localhost' %>" placeholder="localhost" class="input" required />
      </div>
      <div>
        <label for="port" class="mb-1 block text-sm font-medium text-slate-400">Port</label>
        <input type="number" id="port" name="port" value="<%= typeof port !== 'undefined' ? port : '5432' %>" placeholder="5432" class="input" min="1" max="65535" />
      </div>
      <div>
        <label for="user" class="mb-1 block text-sm font-medium text-slate-400">User</label>
        <input type="text" id="user" name="user" value="<%= typeof user !== 'undefined' ? user : '' %>" placeholder="postgres" class="input" required />
      </div>
      <div>
        <label for="password" class="mb-1 block text-sm font-medium text-slate-400">Password</label>
        <input type="password" id="password" name="password" placeholder="••••••••" class="input" />
      </div>
      <div class="flex items-center gap-2">
        <input type="checkbox" id="ssl" name="ssl" value="1" <%= typeof ssl !== 'undefined' && ssl ? 'checked' : '' %> class="rounded border-pg-border bg-pg-panel text-pg-accent focus:ring-pg-accent" />
        <label for="ssl" class="text-sm text-slate-400">Use SSL</label>
      </div>
      <button type="submit" class="btn-primary w-full">Connect</button>
    </form>
  </div>
</div>
