<div class="mx-auto max-w-7xl px-4 py-8">
  <div class="mb-6 flex flex-wrap items-center gap-4">
    <a href="/" class="btn-ghost text-sm">← Database</a>
    <h1 class="font-display text-xl font-bold text-white">
      Structure: <span class="badge-schema"><%= schema %></span>.<span class="text-pg-accent"><%= tableName %></span>
    </h1>
    <a href="/table/<%= encodeURIComponent(schema) %>/<%= encodeURIComponent(tableName) %>" class="btn-secondary text-sm">Browse</a>
    <a href="/query?table=<%= encodeURIComponent(schema) %>.<%= encodeURIComponent(tableName) %>" class="btn-primary text-sm">SQL</a>
  </div>
  <div class="card overflow-hidden">
    <div class="border-b border-pg-border px-6 py-4">
      <h2 class="font-semibold text-white">Columns</h2>
    </div>
    <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>Column</th>
            <th>Type</th>
            <th>Null</th>
            <th>Default</th>
          </tr>
        </thead>
        <tbody>
          <% columns.forEach(function(col) { %>
          <tr>
            <td class="font-mono font-medium"><%= col.name %></td>
            <td><span class="badge-type"><%= col.type %></span></td>
            <td><%= col.notnull ? 'NO' : 'YES' %></td>
            <td class="font-mono text-slate-400"><%= col.default || '—' %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
