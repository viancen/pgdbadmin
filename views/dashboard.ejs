<div class="mx-auto max-w-7xl px-4 py-8">
  <div class="mb-8 flex items-center justify-between">
    <h1 class="font-display text-2xl font-bold text-white">Database: <span class="text-pg-accent"><%= currentDb %></span></h1>
    <a href="/query" class="btn-primary">Run SQL</a>
  </div>
  <div class="card overflow-hidden">
    <div class="border-b border-pg-border px-6 py-4">
      <h2 class="font-semibold text-white">Tables</h2>
      <p class="text-sm text-slate-400">Click a table to browse data or view structure</p>
    </div>
    <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>Schema</th>
            <th>Table</th>
            <th>Columns</th>
            <th class="w-0"></th>
          </tr>
        </thead>
        <tbody>
          <% tables.forEach(function(t) { %>
          <tr>
            <td><span class="badge-schema"><%= t.schema %></span></td>
            <td>
              <a href="/table/<%= encodeURIComponent(t.schema) %>/<%= encodeURIComponent(t.name) %>" class="font-medium text-pg-accent hover:underline"><%= t.name %></a>
            </td>
            <td class="text-slate-400"><%= t.column_count %></td>
            <td class="flex gap-2">
              <a href="/table/<%= encodeURIComponent(t.schema) %>/<%= encodeURIComponent(t.name) %>" class="btn-ghost text-xs">Browse</a>
              <a href="/table/<%= encodeURIComponent(t.schema) %>/<%= encodeURIComponent(t.name) %>/structure" class="btn-ghost text-xs">Structure</a>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% if (!tables.length) { %>
    <div class="px-6 py-12 text-center text-slate-500">No tables in this database.</div>
    <% } %>
  </div>
</div>
